[Unit]
Description=Gesang standalone demo

[Service]
Type=exec
WorkingDirectory=%h/.local/share/gesang-demo
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GESANG_DEMO_DATA_DIR=%S/gesang-demo
Environment=GESANG_DEMO_MODEL_API_KEY_FILE=%d/model-api-key
EnvironmentFile=%h/.config/gesang-demo/settings.env
LoadCredential=model-api-key:%h/.config/gesang-demo/model-api-key
StateDirectory=gesang-demo
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/env node main.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
